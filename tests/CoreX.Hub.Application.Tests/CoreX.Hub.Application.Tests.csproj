    proven against need real processes and real git, so this targets Windows like the
    other execution facing suites.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CoreX.Hub.Application\CoreX.Hub.Application.csproj" />
    <ProjectReference Include="..\..\src\CoreX.Hub.Infrastructure\CoreX.Hub.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\CoreX.Hub.Agents\CoreX.Hub.Agents.csproj" />
    <ProjectReference Include="..\..\src\CoreX.Hub.Workspace\CoreX.Hub.Workspace.csproj" />
    <ProjectReference Include="..\..\src\CoreX.Hub.Cli\CoreX.Hub.Cli.csproj" />
    <ProjectReference Include="..\CoreX.Hub.ProcessFixture\CoreX.Hub.ProcessFixture.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
