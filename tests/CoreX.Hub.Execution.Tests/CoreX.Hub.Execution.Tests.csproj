<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 2 execution primitives are Windows only by design (Job Object based process
    tree termination). Targeting net10.0-windows lets the platform analyzer verify that
    rather than forcing SupportedOSPlatform annotations onto every test.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CoreX.Hub.Execution\CoreX.Hub.Execution.csproj" />
    <ProjectReference Include="..\CoreX.Hub.ProcessFixture\CoreX.Hub.ProcessFixture.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
