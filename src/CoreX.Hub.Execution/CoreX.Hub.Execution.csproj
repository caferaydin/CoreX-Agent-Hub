<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CoreX.Hub.Execution

    The trusted local execution primitives (architecture E, F.5, Phase 2):
    the single process launch boundary and the managed filesystem trust boundary.

    Like CoreX.Hub.Domain this project references no other CoreX.Hub project and no
    third-party package. Enforced by CoreX.Hub.ArchitectureTests.
  -->

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    The native launch path is internal on purpose: no caller outside this project should know
    that CreateProcessW exists, and the fault seam that makes its failure paths testable must
    not be reachable by a provider or a composition root. The tests need both, so they are
    granted access by name rather than by widening the API.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="CoreX.Hub.Execution.Tests" />
  </ItemGroup>

</Project>
